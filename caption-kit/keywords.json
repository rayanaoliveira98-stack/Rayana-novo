{
  "$schema": "./schema.json",
  "version": "1.0.0",
  "language": "de-AT",
  "updated": "2026-09-13",
  "defaults": {
    "captionStyle": "block_2_3",
    "iconStyle": "line",
    "motion": "pop_soft",
    "accent": "accent",
    "priority": 2
  },
  "density": {
    "note": "Regelwerk gegen Icon-Ueberladung. Wenn zu viele Treffer in einem Fenster liegen, gewinnt die hoechste priority; bei Gleichstand der erste Treffer. Alle anderen Treffer behalten die Text-Hervorhebung, verlieren aber das Icon.",
    "maxIconsPer10s": 3,
    "maxIconsPerBlock": 1,
    "minGapBetweenIconsMs": 1200,
    "fallbackWhenSuppressed": "emphasis_only",
    "hookWindowMs": 2000,
    "hookWindowMaxIcons": 1
  },
  "matching": {
    "mode": "word",
    "caseSensitive": false,
    "normalizeUmlauts": false,
    "note": "Wortgrenzen-Match auf den Untertitel-Tokens, nicht auf dem Rohtext. Deutsche Beugung wird ueber inflectionSuffixes abgedeckt; feste Eigennamen (GPT, TikTok) stehen explizit in match und werden nie gebeugt.",
    "inflectionSuffixes": [
      "",
      "s",
      "es",
      "n",
      "en",
      "er",
      "e",
      "in",
      "innen"
    ],
    "compoundMatch": true,
    "compoundNote": "Treffer auch als Teil eines Kompositums: 'Fachkraeftemangel' triggert 'fachkraefte', 'Werbebudget' triggert 'budget'. Icon sitzt am Kompositum, nicht am Teilwort."
  },
