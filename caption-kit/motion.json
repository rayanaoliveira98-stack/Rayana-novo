{
  "version": "1.0.0",
  "updated": "2026-09-13",
  "fps": 30,
  "contract": {
    "name": "no_standstill",
    "note": "Kernregel: In keinem einzigen Frame darf ein sichtbares Element eine Geschwindigkeit von exakt 0 haben. Untertitel und Icon sind immer in Bewegung — entweder in der Ein-/Ausblendung oder in der Idle-Drift. Das ist der Unterschied zwischen 'animiert' und 'lebendig'.",
    "rules": [
      "Jedes sichtbare Element MUSS eine idle-Phase mit Bewegung ungleich null haben.",
      "Der Ausgang von Block A ueberlappt den Eingang von Block B (overlapMs). Es gibt keinen leeren Frame zwischen zwei Bloecken.",
      "Keine linearen Easings. Alle Uebergaenge laufen ueber die brand-Kurven unten.",
      "Kein Hard-Cut auf Untertiteln. Bloecke wechseln ueber Verdraengung, nicht ueber Verschwinden.",
      "Icons verlassen das Bild nie in dieselbe Richtung, aus der sie gekommen sind — sonst wirkt es wie ein Fehler.",
      "Hintergrund/Video traegt eine dauerhafte Ken-Burns-Drift (ambient), damit auch in Sprechpausen nichts einfriert."
    ]
  },
  "easings": {
    "brandOut": {
      "cubicBezier": [
        0.16,
        1,
        0.3,
        1
      ],
      "css": "cubic-bezier(.16,1,.3,1)",
      "use": "Standard-Eingang. Schnell raus, weich aus — wirkt teuer."
    },
    "brandInOut": {
      "cubicBezier": [
        0.65,
        0,
        0.35,
        1
      ],
      "css": "cubic-bezier(.65,0,.35,1)",
      "use": "Positionswechsel, Verdraengung."
    },
    "snap": {
      "cubicBezier": [
        0.2,
        0.9,
        0.1,
        1.06
      ],
      "css": "cubic-bezier(.2,.9,.1,1.06)",
      "use": "Keyword-Betonung. Minimaler Overshoot, kein Wackel-Cartoon."
    },
    "exit": {
      "cubicBezier": [
        0.5,
        0,
        0.75,
        0
      ],
      "css": "cubic-bezier(.5,0,.75,0)",
      "use": "Ausgang. Beschleunigt raus, nie ausbremsen."
    },
    "ambient": {
      "cubicBezier": [
        0.45,
        0,
        0.55,
        1
      ],
      "css": "cubic-bezier(.45,0,.55,1)",
      "use": "Endlos-Drift, Atmen. Immer mit direction: alternate."
    }
  },
  "durations": {
    "blockIn": 260,
    "blockOut": 200,
    "blockOverlap": 120,
    "iconIn": 320,
    "iconHold": 900,
    "iconOut": 240,
    "emphasis": 180,
    "note": "blockOverlap wird von blockOut abgezogen: Block B startet 120 ms bevor Block A weg ist. Deshalb gibt es nie einen leeren Frame."
  },
